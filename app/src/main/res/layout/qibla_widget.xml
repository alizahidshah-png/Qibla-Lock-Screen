<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#102238">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✦ QIBLA • PRAYER COMPANION"
        android:textColor="#C6AD77"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:gravity="center"/>
    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:gravity="center"
        android:textColor="#F5F1E8"
        android:textSize="44sp"
        android:fontFamily="sans"/>
    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#E5D8BD"
        android:textSize="13sp"
        android:text="Loading date…"/>
    <TextView
        android:id="@+id/widget_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:textColor="#C6B07D"
        android:textSize="13sp"
        android:text="Loading Hijri date…"/>
    <TextView
        android:id="@+id/widget_compass_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="9dp"
        android:gravity="center"
        android:background="#243C53"
        android:text="🧭  OPEN LIVE QIBLA COMPASS"
        android:textColor="#F5F1E8"
        android:textSize="12sp"/>
</LinearLayout>